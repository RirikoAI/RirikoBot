# Per-instance settings of one Lavalink container on the Lavalink host. Copy to
# /opt/ririko/lavalink-production.env and /opt/ririko/lavalink-staging.env (root, 0600) and give
# each a different LAVALINK_PASSWORD, so a leaked staging secret cannot drive production audio.
# The bot on the matching app host sets the same value as its LAVALINK_PASSWORD.

# Password the bot authenticates with: openssl rand -hex 32
LAVALINK_PASSWORD=

# Spotify access for the LavaSrc plugin (optional; leave empty to disable)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SP_DC=

# YouTube playback (optional). The Lavalink YouTube plugin can ask a separate cipher server to
# solve the checks YouTube sets. Remove the # from both lines and fill in the values to use one.
# Leave both lines as they are to use the cipher that is built into the plugin.
# Lavalink reads this file only when the container is created. After a change, recreate the
# container by hand: docs/deployment.md section 8.2.
# Address of the cipher server, for example https://cipher.example.com/
# PLUGINS_YOUTUBE_REMOTECIPHER_URL=
# User agent that Lavalink sends to the cipher server, for example ririko-bot
# PLUGINS_YOUTUBE_REMOTECIPHER_USERAGENT=
