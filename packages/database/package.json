{
  "name": "@ririko/database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:push": "drizzle-kit push",
    "db:export": "drizzle-kit export --dialect sqlite --schema ./src/schema/sqlite/index.ts"
  },
  "dependencies": {
    "@ririko/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
