{
  "name": "@ririko/services",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./economy": {
      "types": "./dist/economy/index.d.ts",
      "import": "./dist/economy/index.js"
    },
    "./moderation": {
      "types": "./dist/moderation/index.d.ts",
      "import": "./dist/moderation/index.js"
    }
  },
  "scripts": {
