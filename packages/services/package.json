    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.66",
    "@ririko/core": "workspace:*",
    "@ririko/database": "workspace:*",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
