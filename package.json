{
  "name": "ririko-monorepo",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "dev:bot": "pnpm --filter @ririko/bot dev",
    "start:bot": "pnpm --filter @ririko/bot start",
    "dev:web": "tsc -b && pnpm --filter @ririko/web dev",
    "build:web": "tsc -b && pnpm --filter @ririko/web build",
    "start:web": "pnpm --filter @ririko/web start",
    "lavalink:install": "tsx --env-file=.env scripts/lavalink-setup.ts",
    "lavalink:start": "tsx --env-file=.env scripts/lavalink-start.ts",
    "cli": "tsc -b && tsx apps/cli/src/index.ts",
    "installer": "tsc -b && tsx apps/cli/src/index.ts setup",
    "doctor": "tsc -b && tsx apps/cli/src/index.ts doctor",
    "ai:configure": "tsc -b && tsx apps/cli/src/index.ts ai:configure",
    "db:push": "pnpm --filter @ririko/database db:push",
    "db:check": "tsx scripts/check-migrations.ts",
    "release:version": "tsx scripts/release/version.ts",
    "release:notes": "tsx scripts/release/notes.ts",
    "release:prepare": "tsx scripts/release/prepare.ts",
    "release:publish": "tsx scripts/release/publish.ts",
    "db:generate": "pnpm --filter @ririko/database db:generate-sql && pnpm --filter @ririko/database db:generate-migrations && pnpm --filter @ririko/database db:generate-ddl && prettier --write packages/database/src/schema/sqlite/ddl.ts packages/database/src/schema/pg/ddl.ts",
    "db:reset": "tsc -b && tsx scripts/db-reset.ts",
    "tcg:generate-assets": "tsx scripts/generate-tcg-assets.ts",
    "tcg:card-builder": "tsc -b && tsx scripts/tcg-card-builder.ts",
    "tcg:boss-builder": "tsc -b && tsx --env-file-if-exists=.env scripts/tcg-boss-builder.ts",
    "tcg:reset-user": "tsc -b && tsx scripts/reset-tcg-user.ts",
    "tcg:simulate": "tsc -b && tsx --env-file-if-exists=.env scripts/tcg-balance-sim.ts",
    "docs:commands": "tsx scripts/export-commands.ts",
    "docs:dev": "pnpm docs:commands && pnpm --filter website dev",
    "docs:install": "tsx scripts/export-install-files.ts",
    "readme:banner": "tsx scripts/render-readme-banner.ts",
    "docs:build": "pnpm docs:commands && pnpm docs:install && pnpm --filter website build",
    "docs:serve": "pnpm --filter website serve",
    "typecheck": "pnpm -r run typecheck && tsc -p tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:file-coverage": "tsx scripts/file-coverage.ts",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:postgres": "vitest run packages/database/src packages/services/src",
    "test:integration": "vitest run apps/bot/test/ tests/support/",
    "test:e2e": "pnpm build:web && pnpm --filter @ririko/web exec playwright test",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.66",
    "@next/eslint-plugin-next": "~16.4.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yml,yaml,css}": "prettier --write --ignore-unknown"
  }
}
