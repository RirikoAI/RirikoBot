# Ririko AI 2.0 production settings for docker-compose.production.yml.
# Copy to .env.production and fill in the required values. Every service reads this file;
# DATABASE_* and LAVALINK_HOST/PORT are set by the compose file itself.

# --- Required --------------------------------------------------------------
# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public address of the dashboard; add <DASHBOARD_URL>/api/auth/callback as an OAuth2 redirect
DASHBOARD_URL=https://dashboard.example.com
# 64 hex characters: openssl rand -hex 32. Losing it makes stored credentials unreadable.
SECRET_VAULT_KEY=
# PostgreSQL superuser password for the bundled database
POSTGRES_PASSWORD=
# Shared secret between the bot and Lavalink
LAVALINK_PASSWORD=

# --- Optional --------------------------------------------------------------
# Image tag to run (2, 2.0 or 2.0.0); defaults to 2
# RIRIKO_VERSION=2
# Host address the dashboard port binds to. 127.0.0.1 (the default) reaches it only from the host
# itself, for a reverse proxy or tunnel running there. Use 0.0.0.0 only on a host whose own
# firewall or reverse proxy protects the port.
# DASHBOARD_BIND=127.0.0.1
# Host port of the dashboard
# DASHBOARD_PORT=3000
# Request header the dashboard trusts for the client IP (rate limits, session and audit records).
# Unset, it uses the first X-Forwarded-For entry, which a client can forge. Behind Cloudflare use
# cf-connecting-ip. SAFE ONLY when every request reaches the dashboard through Cloudflare (for
# example a tunnel with DASHBOARD_BIND=127.0.0.1): any other path lets a client set the header
# itself and pick its own rate-limit bucket. The value must be a valid IP address; there is no
# fallback to X-Forwarded-For.
# CLIENT_IP_HEADER=cf-connecting-ip
# Java heap of Lavalink (default 1G). Use 512m on a 4 GB host.
# LAVALINK_HEAP=1G
# POSTGRES_USER=ririko
# POSTGRES_DB=ririko
NODE_ENV=production
# BOT_OWNER_ID=
# DEFAULT_PREFIX=!

# AI chat
# DEFAULT_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=

# Image generation
# REPLICATE_API_TOKEN=
# COMFYUI_URL=

# Stream alerts
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# Spotify (bot and Lavalink)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_SP_DC=
