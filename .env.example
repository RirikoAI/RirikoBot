# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=
DISCORD_DEV_GUILD_ID=

# Bot Configuration
DEFAULT_PREFIX=!
BOT_OWNER_ID=your_discord_user_id

# Dual-Dialect Database
DATABASE_DIALECT=sqlite
DATABASE_URL=./data/ririko.sqlite

# Spotify User Session Spoofing (Cookie sp_dc & sp_key from open.spotify.com)
# To obtain: Open DevTools on open.spotify.com -> Application -> Cookies -> Copy 'sp_dc'
SPOTIFY_DC=
SPOTIFY_KEY=

# Optional Spotify Developer App Credentials (for full Spotify Web API search)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional YouTube BotGuard & Authentication Credentials
# Improves YouTube playback reliability and prevents SABR / 403 blocks on official music videos
# To obtain Cookie: Export cookies from youtube.com in Netscape format or copy raw cookie header string
YOUTUBE_COOKIE=
# Proof of Origin (PO-Token) and visitor data from YouTube player session
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# AI Chatbot & LLM Providers Configuration
# Primary AI Provider: 'gemini' (Recommended flagship), 'openai', or 'ollama' (Local/self-hosted)
DEFAULT_AI_PROVIDER=gemini
# Primary model override (optional, leave blank to use provider defaults)
DEFAULT_AI_MODEL=

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key & optional custom Base URL (e.g. OpenRouter, Groq, local proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama / Local Inference server base URL
OLLAMA_BASE_URL=http://localhost:11434

# Stream Watcher & Live Alerts (Twitch, YouTube, TikTok)
# Twitch Helix API Credentials (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Cloud YouTube Data API v3 Key (from https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# TikTok Session ID Cookie (optional, to bypass anti-bot challenges)
TIKTOK_SESSION_ID=
TIKTOK_API_KEY=

# Stream Polling Interval in milliseconds (default: 60000 / 1 minute)
STREAM_CHECK_INTERVAL_MS=60000

# Daily Reset Boundary
# Every daily system (energy, energy potions, shop rotation, shop purchase limits and /daily)
# resets on one shared boundary. Offset is minutes ahead of UTC: 480 = GMT+8.
RIRIKO_RESET_OFFSET_MINUTES=480
# Default wall-clock reset time inside that offset, as HH:MM.
RIRIKO_RESET_TIME=00:00
# Per-feature overrides. Leave blank to inherit RIRIKO_RESET_TIME.
# RIRIKO_RESET_TIME_DAILY=
# RIRIKO_RESET_TIME_ENERGY=
# RIRIKO_RESET_TIME_ENERGY_POTIONS=
# RIRIKO_RESET_TIME_TCG_SHOP=
# RIRIKO_RESET_TIME_SHOP_PURCHASES=
# Consecutive missed days tolerated before a /daily streak is wiped. 0 disables forgiveness.
RIRIKO_DAILY_STREAK_FORGIVENESS=3

# Runtime
NODE_ENV=development
LOG_LEVEL=info
# Register slash commands on startup. Uses DISCORD_DEV_GUILD_ID when set (instant), otherwise global.
SYNC_COMMANDS=false

# AES-256-GCM credential vault key: 64 hex chars (generate with `openssl rand -hex 32`)
# Required by the web dashboard (encrypts stored Discord OAuth2 tokens).
# SECRET_VAULT_KEY=
# Rotation: raise the version when you replace SECRET_VAULT_KEY and list retired keys as
# <version>:<hex>,... so data encrypted under them stays readable.
# SECRET_VAULT_KEY_VERSION=1
# SECRET_VAULT_PREVIOUS_KEYS=

# Web Dashboard (apps/web). Also requires DISCORD_CLIENT_SECRET and SECRET_VAULT_KEY.
# Public origin of the dashboard. Register `${DASHBOARD_URL}/api/auth/callback` as an OAuth2
# redirect URI in the Discord Developer Portal.
DASHBOARD_URL=http://localhost:3000

# Lavalink 4 (music). `pnpm lavalink:install` writes these into lavalink/application.yml,
# so the bot and the Lavalink server must use the same password.
LAVALINK_ENABLED=true
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# Spotify sp_dc cookie for the LavaSrc plugin (same value as SPOTIFY_DC)
SPOTIFY_SP_DC=
