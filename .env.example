NODE_ENV=development
DATABASE_DIALECT=sqlite
DATABASE_URL=data/ririko.db
DEFAULT_PREFIX=!
LOG_LEVEL=info
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3001
# Required only for starting the bot or synchronizing commands:
# DISCORD_TOKEN=replace-with-bot-token
# DISCORD_APPLICATION_ID=123456789012345678
# Development command registration target:
# DISCORD_GUILD_ID=123456789012345678
# Required for privileged local CLI writes (comma-separated Discord owner IDs):
# BOT_OWNER_IDS=123456789012345678
