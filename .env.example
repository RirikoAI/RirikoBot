# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=
DISCORD_DEV_GUILD_ID=

# Bot Configuration
DEFAULT_PREFIX=!
# Comma-separated Discord user IDs of the bot owners (dashboard owner console access)
BOT_OWNER_ID=

# Dual-Dialect Database
DATABASE_DIALECT=sqlite
DATABASE_URL=./data/ririko.sqlite
# The bot applies pending schema migrations when it starts (default true). With false it only
# checks and refuses to start while migrations are pending: run `ririko db:migrate` first.
# The dashboard never changes the schema; it waits until the bot or `ririko db:migrate` has.
# (docs/deployment.md section 2, docs/database.md section 1)
# DB_AUTO_MIGRATE=true
# Upgrading from 1.4.0: the old SQLite file, migrated once on startup and never written
# (docs/migrations.md section 4). The Docker image sets /app/legacy/ririko.db.
# LEGACY_DATABASE_PATH=../ririko-1.4/data/ririko.db

# Bot /health and /ready probes (docs/deployment.md section 3); 0 turns them off
# HEALTH_PORT=8080

# Spotify User Session Spoofing (Cookie sp_dc & sp_key from open.spotify.com)
# To obtain: Open DevTools on open.spotify.com -> Application -> Cookies -> Copy 'sp_dc'
SPOTIFY_DC=
SPOTIFY_KEY=

# Optional Spotify Developer App Credentials (for full Spotify Web API search)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Private music package: `true` loads extra sources into the built-in player that runs when
# Lavalink is unavailable. Leave `false` unless packages/music-private is cloned and built; music
# through Lavalink works either way. The package documents its own variables.
USE_PRIVATE_MUSIC_PACKAGE=false

# AI Chatbot & LLM Providers Configuration
# Primary AI Provider: 'gemini' (Recommended flagship), 'openai', or 'ollama' (Local/self-hosted)
DEFAULT_AI_PROVIDER=gemini
# Primary model override (optional, leave blank to use provider defaults)
DEFAULT_AI_MODEL=

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key & optional custom Base URL (e.g. OpenRouter, Groq, local proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama / Local Inference server base URL
OLLAMA_BASE_URL=http://localhost:11434

# Image Generation (/imagine)
# Provider used when neither the member nor the server picks one: gemini, replicate, comfyui or mock
IMAGE_DEFAULT_PROVIDER=gemini
# Images each member may generate in 24 hours across all servers (0 for no limit). Servers can set a lower limit.
IMAGE_DAILY_QUOTA=30
# Replicate API token (Flux models, from https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=
# ComfyUI / Stable Diffusion WebUI server (COMFYUI_BASE_URL and SD_WEBUI_URL are also read)
COMFYUI_URL=

# Stream Watcher & Live Alerts (Twitch, YouTube, TikTok)
# The dashboard reads these too, to resolve handles on the Stream Alerts page.
# Twitch Helix API Credentials (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Cloud YouTube Data API v3 Key (from https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# TikTok Session ID Cookie (optional, to bypass anti-bot challenges)
TIKTOK_SESSION_ID=
TIKTOK_API_KEY=

# Stream Polling Interval in milliseconds (default: 60000 / 1 minute)
STREAM_CHECK_INTERVAL_MS=60000

# Daily Reset Boundary
# Every daily system (energy, energy potions, shop rotation, shop purchase limits and /daily)
# resets on one shared boundary. Offset is minutes ahead of UTC: 480 = GMT+8.
RIRIKO_RESET_OFFSET_MINUTES=480
# Default wall-clock reset time inside that offset, as HH:MM.
RIRIKO_RESET_TIME=00:00
# Per-feature overrides. Leave blank to inherit RIRIKO_RESET_TIME.
# RIRIKO_RESET_TIME_DAILY=
# RIRIKO_RESET_TIME_ENERGY=
# RIRIKO_RESET_TIME_ENERGY_POTIONS=
# RIRIKO_RESET_TIME_TCG_SHOP=
# RIRIKO_RESET_TIME_SHOP_PURCHASES=
# Consecutive missed days tolerated before a /daily streak is wiped. 0 disables forgiveness.
RIRIKO_DAILY_STREAK_FORGIVENESS=3

# Runtime
NODE_ENV=development
LOG_LEVEL=info
# Register commands on startup: member commands globally, admin commands per server (in
# DISCORD_DEV_GUILD_ID when set, otherwise every server). `pnpm cli commands:sync` does the same
# without a restart.
SYNC_COMMANDS=false

# AES-256-GCM credential vault key: 64 hex chars (generate with `openssl rand -hex 32`)
# Required by the web dashboard (encrypts stored Discord OAuth2 tokens).
# SECRET_VAULT_KEY=
# Rotation: raise the version when you replace SECRET_VAULT_KEY and list retired keys as
# <version>:<hex>,... so data encrypted under them stays readable.
# SECRET_VAULT_KEY_VERSION=1
# SECRET_VAULT_PREVIOUS_KEYS=

# Web Dashboard (apps/web). Also requires DISCORD_CLIENT_SECRET and SECRET_VAULT_KEY.
# Public origin of the dashboard. Register `${DASHBOARD_URL}/api/auth/callback` as an OAuth2
# redirect URI in the Discord Developer Portal.
DASHBOARD_URL=http://localhost:3000
# Discord HTTP API base for the dashboard's server-side calls. Leave unset in production; the
# Playwright E2E suite points it at a local fake (plain http is accepted for loopback only).
# DISCORD_API_URL=https://discord.com/api
# Request header trusted for the client IP (rate limits, session and audit records). Unset, the
# dashboard uses the first X-Forwarded-For entry, which a client can forge. Set it only when every
# request comes through the proxy that sets it, such as cf-connecting-ip behind Cloudflare.
# CLIENT_IP_HEADER=

# Lavalink 4 (music). `pnpm lavalink:install` writes these into lavalink/application.yml,
# so the bot and the Lavalink server must use the same password.
LAVALINK_ENABLED=true
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# Optional yt-cipher server for the Lavalink YouTube plugin (e.g. https://example.com/).
# Leave empty to use the plugin's built-in signature cipher.
LAVALINK_YOUTUBE_CIPHER_URL=
# Spotify sp_dc cookie for the LavaSrc plugin (same value as SPOTIFY_DC)
SPOTIFY_SP_DC=
